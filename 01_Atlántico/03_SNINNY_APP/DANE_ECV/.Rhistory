folders    <- c("SISBEN_2021", "SISBEN_2022", "SISBEN_2023", "SISBEN_2024")
FORZAR_DELIM <- NULL  # si sabes el separador, ponlo (p.ej. "|")
# ===== Conversión: numérico si no agrega NA; si no, texto =====
safe_num_or_text <- function(x) {
x_chr <- as.character(x)
x_num <- suppressWarnings(as.numeric(x_chr))
# Si convertir a numérico introduce más NA que los que ya había, conservar como texto
if (sum(is.na(x_num)) > sum(is.na(x_chr))) x_chr else x_num
}
convert_df_types <- function(df) {
df %>% mutate(across(everything(), safe_num_or_text))
}
# ====== Lector robusto de TXT (solo columnas en texto para ahorrar parseo) ======
leer_txt <- function(filepath) {
enc <- tryCatch(readr::guess_encoding(filepath, n_max = 2000)$encoding[1],
error = function(e) "UTF-8")
vroom::vroom(
file   = filepath,
delim  = FORZAR_DELIM,                      # si es NULL, vroom intenta autodetectar
col_types = cols(.default = col_character()), # evita parseo costoso al leer
guess_max = 10000,                          # ajusta si tus archivos son enormes
locale = readr::locale(encoding = enc %||% "UTF-8"),
altrep = TRUE,                              # permite ahorro de memoria (lazy)
show_col_types = FALSE,
progress = FALSE
) |>
janitor::clean_names()
}
# ====== Helper para encontrar y leer un archivo por patrón ======
leer_por_patron <- function(dir_full, patron_regex) {
archivos <- list.files(dir_full, pattern = "\\.txt$", full.names = TRUE)
idx <- which(str_detect(basename(archivos), regex(patron_regex, ignore_case = TRUE)))
if (!length(idx)) stop("No encontré archivo que cumpla el patrón: ", patron_regex, " en ", dir_full)
leer_txt(archivos[idx[1]])
}
