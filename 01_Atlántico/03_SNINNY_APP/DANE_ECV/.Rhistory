geom_line(aes(y=ultimo_netflix,colour="Acción de Netflix"), size=1.05)+
geom_line(aes(y=ultimo_syp, colour="S&P 500"), size=1.05) +
scale_color_manual(values=c("Acción de Netflix"="#a0522d",
"S&P 500" = "#FFA54F"))+
theme_minimal()+xlab("Daily")+theme(legend.position = "bottom")+ylab("USD nominal")
labs(color = NULL)
grafico_acciones
#### Transformación de tasas crecimiento (Normalizamos nuestras variables)
data_total <- data_total %>%
arrange(fecha) %>%
mutate(
# Tasa de crecimiento porcentual
tc_netflix = ((ultimo_netflix - lag(ultimo_netflix, n = 1)) / lag(ultimo_netflix, n = 1)) * 100,
# Tasa de crecimiento logarítmica
tc_l_netflix = (log(ultimo_netflix) - lag(log(ultimo_netflix), n = 1)) * 100,
log_netflix= log(ultimo_netflix),
# Tasa de crecimiento porcentual
tc_syp = ((ultimo_syp - lag(ultimo_syp, n = 1)) / lag(ultimo_syp, n = 1)) * 100,
# Tasa de crecimiento logarítmica
tc_l_syp = (log(ultimo_syp) - lag(log(ultimo_syp), n = 1)) * 100,
log_syp= log(ultimo_syp))
#### Gráfico de tasa crecimiento
grafico_acciones_tc <- ggplot(data_total,aes(x = fecha))+
geom_line(aes(y=tc_netflix,colour="Tasa de crecimiento de Netflix"), size=1.05)+
geom_line(aes(y=tc_syp, colour="Tasa de crecimiento de S&P 500"), size=1.05) +
scale_color_manual(values=c("Tasa de crecimiento de Netflix"="#a0522d",
"Tasa de crecimiento de S&P 500" = "#FFA54F"))+
theme_minimal()+xlab("Daily")+theme(legend.position = "bottom")+ylab("TC of USD nominal")
labs(color = NULL)
grafico_acciones_tc
grafico_acciones_log <- ggplot(data_total,aes(x = fecha))+
geom_line(aes(y=tc_netflix,colour="Log de Netflix"), size=1.05)+
geom_line(aes(y=tc_syp, colour="Log de S&P 500"), size=1.05) +
scale_color_manual(values=c("Log de Netflix"="#a0522d",
"Log de S&P 500" = "#FFA54F"))+
theme_minimal()+xlab("Daily")+theme(legend.position = "bottom")+ylab("Logs of USD nominal")
labs(color = NULL)
grafico_acciones_log
data_total <- na.omit(data_total)
data_syp <- subset(data_total, select = c(log_syp))
#### Crear variables rezagadas (lags) de la variable S&P 500
syp_lag <- data.frame(
Lag0 = data_syp$log_syp,
Lag1 = c(NA, head(data_syp$log_syp, -1)),  # Rezago de 1 período
Lag2 = c(NA, NA, head(data_syp$log_syp, -2)),  # Rezago de 2 períodos
Lag3 = c(NA, NA, NA, head(data_syp$log_syp, -3))  # Rezago de 3 períodos
)
# Convertir syp_lag a matriz numérica
syp_lag_matrix <- as.matrix(syp_lag)
# Aseguramos que los rezagos se alineen con la serie de Netflix
syp_lag <- na.omit(syp_lag)
#######
### Conformación de pruebas
######
# Aplicamos prueba de dickey fuller aumentado para conocer si la serie es estacionaria o no.
# Aplicar la prueba ADF
adf.test(data_total$tc_netflix)
adf.test(data_total$log_netflix)
adf.test(data_total$ultimo_netflix)
adf.test(data_total$tc_syp)
adf.test(data_total$log_syp)
adf.test(data_total$ultimo_syp)
# modelo ARMAX
modelo_inicial <- arima(data_total$log_netflix, order = c(1,0,1), xreg = data_syp$log_syp,
include.mean=F,method = c("ML"))
summary(modelo_inicial)
coeftest(modelo_inicial)
modelo_inicial_b <- arima(data_total$log_netflix, order = c(2,0,1), xreg = data_syp$log_syp,
include.mean=F,method = c("ML"))
summary(modelo_inicial_b)
coeftest(modelo_inicial_b)
# Modelo SARMAX
modelo_x <- arima(data_total$log_netflix[4:nrow(data_total)], order = c(1,0,0),
xreg = as.matrix(syp_lag), include.mean = T, method = c("CSS"),
seasonal = list(order = c(0, 1, 2), period = 75))
summary(modelo_x)
coeftest(modelo_x)
predicciones <- predict(modelo_x, n.ahead = 10, newxreg = as.matrix(syp_lag[(nrow(syp_lag) - 10 + 1):nrow(syp_lag), ]))
predicciones_df <- data.frame(predicciones$pred)
predicciones_df <- predicciones_df  %>% mutate(accion_netflix = exp(predicciones_df$predicciones.pred))
View(predicciones_df)
