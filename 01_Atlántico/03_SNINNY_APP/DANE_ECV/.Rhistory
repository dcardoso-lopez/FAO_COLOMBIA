)
# MPIOs
munic_colombia <- sf::st_read(
"C:/Users/Dell/Universidad de los andes/FAO-SAT - Documentos/General/06_Scripts/01_Datos de matriz de indicadores/DATA_ORIGINAL/091_SHP_MGN2018_INTGRD_MPIO/MGN_ANM_MPIOS.shp",
