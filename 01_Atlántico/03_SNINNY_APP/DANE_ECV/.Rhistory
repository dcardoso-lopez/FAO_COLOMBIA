MPIO_CCDGO = as.integer(MPIO_CCDGO),   # DIVIPOLA municipal numérico
MPIO_CNMBR = as.character(MPIO_CNMBR)
)
# --------------------------------------------------------------------------------------------------
# UTIL: normalizar nombres (si llegas a mapear por nombre)
# --------------------------------------------------------------------------------------------------
normalize_name <- function(x){
x <- toupper(iconv(x, from = "", to = "ASCII//TRANSLIT"))
x <- gsub("[^A-Z0-9 ]", " ", x)
x <- gsub("\\s+", " ", x)
trimws(x)
}
dptos_colombia$DPTO_CNMBR_NORM <- normalize_name(dptos_colombia$DPTO_CNMBR)
# --------------------------------------------------------------------------------------------------
# DIRECTORIOS
# --------------------------------------------------------------------------------------------------
# Carpeta donde se guardarán los tiles Hansen y también el panel (C:)
tiles_base_dir <- "C:/Users/Dell/Universidad de los andes/FAO-SAT - Documentos/General/06_Scripts/01_Datos de matriz de indicadores/DATA_ORIGINAL/141_HANSEN_DEFORESTATION"
fs::dir_create(tiles_base_dir)
# Carpeta espejo en G: (opcional) para guardar otra copia del panel
dir_out_panel_g <- "G:/Mi unidad/Propuesta de investigación - Diego Cardoso/Data_mod"
fs::dir_create(dir_out_panel_g)
# Guardaremos el panel en AMBAS rutas
panel_out_dirs <- c(tiles_base_dir, dir_out_panel_g)
# --------------------------------------------------------------------------------------------------
# CÓDIGOS DEPARTAMENTALES (TEXTO "00")
# --------------------------------------------------------------------------------------------------
departamentos_codigos_str <- c(
"88","44","54","76","73","68","66","63","52","50",
"41","27","25","23","19","17","15","11","08","05"
)
# =========================================================================================
# (1) DESCARGA DE TILES GFC POR DEPARTAMENTO (DIVIPOLA string con cero a la izquierda)
#     + Escritura de shapefile con nombres de campo seguros (≤10 chars)
# =========================================================================================
for (dpto_code_str in departamentos_codigos_str) {
dpto_data <- dptos_colombia |>
dplyr::filter(DPTO_CODE_STR == dpto_code_str)
if (nrow(dpto_data) == 0) {
warning("DPTO no encontrado para código: ", dpto_code_str)
next
}
# Carpeta de ese dpto por código (en C:)
dout_dpto <- file.path(tiles_base_dir, dpto_code_str)
fs::dir_create(dout_dpto)
# gfcanalysis trabaja en WGS84
dpto_wgs <- sf::st_transform(dpto_data, 4326)
# Calcular y descargar tiles Hansen (GFC 2022 v1.10)
tles_dpto <- gfcanalysis::calc_gfc_tiles(dpto_wgs)
gfcanalysis::download_tiles(tles_dpto, dout_dpto)
# ---- Guardar shapefile del dpto (siempre sobrescribir con nombres seguros) ----
base_out <- file.path(dout_dpto, dpto_code_str)
# 1) Elimina cualquier shapefile previo (todos los sidecars)
purrr::walk(c(".shp", ".shx", ".dbf", ".prj", ".cpg"),
~unlink(paste0(base_out, .x), force = TRUE))
# 2) Selecciona SOLO campos necesarios y renómbralos a ≤10 caracteres
dpto_wgs_write <- dpto_wgs %>%
dplyr::select(DPTO_CCDGO, DPTO_CNMBR, DPTO_CODE_STR) %>%
dplyr::rename(
DPTO_CODE = DPTO_CODE_STR  # 9 caracteres
)
# 3) Escribe forzando sobreescritura del dataset (evita "update")
sf::st_write(
dpto_wgs_write,
paste0(base_out, ".shp"),
driver        = "ESRI Shapefile",
delete_dsn    = TRUE,   # borra dataset si existe
append        = FALSE,
layer_options = "ENCODING=UTF-8",
quiet         = TRUE
)
message("Shapefile (DPTO) escrito en: ", paste0(base_out, ".shp"))
# (Opcional) Exponer objeto a GlobalEnv
assign(paste0("dpto_", dpto_code_str), dpto_wgs, envir = .GlobalEnv)
}
