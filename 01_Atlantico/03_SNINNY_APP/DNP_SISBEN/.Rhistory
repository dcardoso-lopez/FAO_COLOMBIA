datos <- bind_rows(mget(ls(pattern = "^datos_")))
rm(list = ls(pattern = "^datos_"))
gc()
unique(datos$ENAB_DESTINO)
datos$ENAB_DESTINO <- datos$ENAB_DESTINO %>%
gsub("Ã¡", "á", .) %>%
gsub("Ã©", "é", .) %>%
gsub("Ã­", "í", .) %>%
gsub("Ã³", "ó", .) %>%
gsub("Ãº", "ú", .) %>%
gsub("Ã±", "ñ", .)
unique(datos$ENAB_DESTINO)
datos$DEPT_ID <- gsub("'", "", datos$DEPT_ID)
datos$MUNI_ID <- gsub("'", "", datos$MUNI_ID)
datos$DEPT_ID <- ifelse(nchar(datos$DEPT_ID) == 1, paste0("0", datos$DEPT_ID), datos$DEPT_ID)
datos$MUNI_ID <- ifelse(nchar(datos$MUNI_ID) == 1, paste0("00", datos$MUNI_ID), datos$MUNI_ID)
datos$MUNI_ID <- ifelse(nchar(datos$MUNI_ID) == 2, paste0("0", datos$MUNI_ID), datos$MUNI_ID)
datos$MUNI_ID <- ifelse(nchar(datos$MUNI_ID) == 3, paste0(datos$DEPT_ID, datos$MUNI_ID), datos$MUNI_ID)
datos$GRUP_NOMBRE <- ifelse(datos$GRUP_NOMBRE == "TUBERCULOS, RAICES Y PLATAN", "TUBERCULOS, RAICES Y PLATANOS", datos$GRUP_NOMBRE)
datos$ARTI_NOMBRE <- datos$ARTI_NOMBRE %>%
gsub("Ã¡", "á", .) %>%
gsub("Ã©", "é", .) %>%
gsub("Ã­", "í", .) %>%
gsub("Ã³", "ó", .) %>%
gsub("Ãº", "ú", .) %>%
gsub("Ã±", "ñ", .) %>%
gsub("Ã\u0091", "Ñ", .)
datos$ARTI_NOMBRE <- ifelse(datos$ARTI_NOMBRE == "Maíz Amarillo", "Maíz amarillo", datos$ARTI_NOMBRE)
datos$ARTI_NOMBRE <- ifelse(datos$ARTI_NOMBRE == "Maíz Blanco", "Maíz blanco", datos$ARTI_NOMBRE)
datos <-datos%>%select(-V10, -"Codigo CPC")
datos$REAB_CANTIDAD_PR <- as.numeric(datos$REAB_CANTIDAD_PR)
datos<- na.omit(datos)
datos$fecha_completa<-paste0(datos$ANIO, "-", datos$MES, "-", datos$DIA)
names(datos)[names(datos) == "ANIO"] <- "ano"
names(datos)[names(datos) == "MES"] <- "mes"
names(datos)[names(datos) == "DIA"] <- "dia"
datos$ano <- as.numeric(datos$ano)
datos$mes <- as.numeric(datos$mes)
datos$dia <- as.numeric(datos$dia)
datos <- datos %>%
mutate(trimestre = paste0(
ano,
"-T",
case_when(
mes %in% 1:3   ~ 1,
mes %in% 4:6   ~ 2,
mes %in% 7:9   ~ 3,
mes %in% 10:12 ~ 4,
TRUE ~ NA_real_
)
))
datos <- datos %>%
mutate(semestre = paste0(
ano,
"-S",
case_when(
mes %in% 1:6   ~ 1,
mes %in% 7:12   ~ 2,
TRUE ~ NA_real_
)
))
