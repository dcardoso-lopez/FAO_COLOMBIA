"Ibagué", "Ipiales", "Manizales", "Medellín",
"Montería", "Neiva", "Pasto", "Pereira",
"Popayán", "Santa Marta (Magdalena)", "Sincelejo",
"Tibasosa (Boyacá)", "Tunja", "Valledupar", "Villavicencio"
),
cod_dane = c(
"63001", "08001", "11001", "68001",
"76001", "13001", "54001", "18001",
"73001", "52506", "17001", "05001",
"23001", "41001", "52001", "66001",
"19001", "47001", "70001", "15810",
"15001", "20001", "50001"
)
)
